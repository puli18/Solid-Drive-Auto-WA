# Client preview build (Cloudflare Pages, `pnpm --filter web build:preview` / `dev:demo`): Vite mode "preview".
# Demo mode (bundled demo logins, settings, bookings, enquiries; nothing is sent) with the CARS read from the
# live Firestore project (public reads of published cars only; the preview never writes to Firestore).
# Firebase web config is public (it ships in every client bundle) – safe to commit.
# Overrides apps/web/.env.local (which points at the emulators) for this mode.
VITE_DEMO_MODE=true
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=AIzaSyBqNVnAC3mBUl8kt4R8j87qwOQxdvI08c0
VITE_FIREBASE_AUTH_DOMAIN=solid-drive-auto-wa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=solid-drive-auto-wa
VITE_FIREBASE_STORAGE_BUCKET=solid-drive-auto-wa.firebasestorage.app
VITE_FIREBASE_APP_ID=1:96339585403:web:2cb785f6e5656dbc64b5de
VITE_FUNCTIONS_REGION=australia-southeast1
# App Check off for the preview (no reCAPTCHA Enterprise site key yet).
VITE_APPCHECK_SITE_KEY=
# Cloudflare's always-pass test key (forms are simulated in demo mode anyway).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_CF_IMAGES_DELIVERY_URL=
VITE_SITE_URL=https://solid-drive-preview.pages.dev
