# Live site build (`pnpm --filter web build`, Vite mode "production"): the real Firebase backend
# (Firestore, Auth, Cloud Functions) of project solid-drive-auto-wa. Cloudflare Pages project solid-drive-auto-wa
# builds this on every push to main and serves it on soliddriveauto.com.au, www. and solid-drive-auto-wa.pages.dev.
# Firebase web config is public (it ships in every client bundle) – safe to commit. Every key is set here so a
# local apps/web/.env.local (emulators) can't leak into a production build.
VITE_DEMO_MODE=false
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=AIzaSyBqNVnAC3mBUl8kt4R8j87qwOQxdvI08c0
VITE_FIREBASE_AUTH_DOMAIN=solid-drive-auto-wa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=solid-drive-auto-wa
VITE_FIREBASE_STORAGE_BUCKET=solid-drive-auto-wa.firebasestorage.app
VITE_FIREBASE_APP_ID=1:96339585403:web:2cb785f6e5656dbc64b5de
# Callables, HTTP and scheduled functions run here (Firestore triggers run next to the database).
VITE_FUNCTIONS_REGION=australia-southeast1
# App Check off until a reCAPTCHA Enterprise site key exists (functions run with ENFORCE_APP_CHECK=false).
VITE_APPCHECK_SITE_KEY=
# Cloudflare's always-pass TEST site key. The functions' TURNSTILE_SECRET_KEY is still `unset`, which makes them
# accept any token (no bot protection yet). Set the real site key here BEFORE or together with the real secret:
# a real secret rejects the test key's dummy token, so every form would fail.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Cloudflare Images delivery URL – empty until Cloudflare Images is set up (car photos are `local:` ids today).
VITE_CF_IMAGES_DELIVERY_URL=
# Canonical host (canonical tags, sitemap, schema.org).
VITE_SITE_URL=https://soliddriveauto.com.au
VITE_ALLOW_INDEXING=true
