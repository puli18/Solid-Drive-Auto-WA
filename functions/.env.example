# Copy to functions/.env.local for the emulator (copied into functions/lib by the build).
# In staging/prod these come from Secret Manager (see src/core/config.ts).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Solid Drive Auto WA <onboarding@resend.dev>"
DEALERSHIP_NOTIFY_EMAIL=sales@soliddrive.test
CF_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
CF_ZONE_ID=
CF_CACHE_PURGE_TOKEN=
STOCK_FEED_KEY=
SITE_URL=http://localhost:3000
# Cloudflare Images delivery base for stockFeed image URLs, e.g. https://imagedelivery.net/<account_hash>
CF_IMAGES_DELIVERY_URL=
# Secret Manager cannot hold an empty secret: use the value "unset" for keys not available yet (treated as missing).
