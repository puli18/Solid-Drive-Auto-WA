{
  "name": "functions",
  "version": "0.1.0",
  "private": true,
  "description": "Firebase Cloud Functions (2nd gen, Node 20) for Solid Drive Auto WA",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "node scripts/clean-lib.mjs && tsup && node scripts/prepare-deploy.mjs",
    "build:watch": "node scripts/clean-lib.mjs && tsup --watch --onSuccess \"node scripts/prepare-deploy.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "create-admin": "tsx scripts/createAdmin.ts",
    "test:emulator": "bash ../scripts/with-java.sh ../node_modules/.bin/firebase emulators:exec --only firestore,auth,storage --project demo-solid-drive \"vitest run --config vitest.emulator.config.ts\"",
    "test:emulator:run": "vitest run --config vitest.emulator.config.ts"
  },
  "dependencies": {
    "@react-email/components": "^1.0.0",
    "@react-email/render": "^2.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "ics": "^3.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.0.0",
    "stripe": "^19.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@sda/shared": "workspace:*",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
