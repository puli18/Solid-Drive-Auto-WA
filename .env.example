# ---------------------------------------------------------------------------
# Solid Drive Auto WA – environment variables
# Copy to apps/web/.env.local (web) and functions/.env.local (functions, emulator only).
# Real secrets live in Cloudflare env vars (web) and Firebase Secret Manager (functions).
# Never commit real values.
# ---------------------------------------------------------------------------

# ---- web (apps/web) --------------------------------------------------------
# Firebase client config. For local dev against the emulators any non-empty
# apiKey works; projectId must be demo-solid-drive.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-solid-drive.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-solid-drive
VITE_FIREBASE_STORAGE_BUCKET=demo-solid-drive.appspot.com
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# Connect the client SDK to the local Emulator Suite (true for local dev only).
VITE_USE_EMULATORS=true
# Functions region (must match functions/src/lib/config.ts).
VITE_FUNCTIONS_REGION=australia-southeast1
# App Check (reCAPTCHA Enterprise site key). Leave empty locally: App Check is skipped.
VITE_APPCHECK_SITE_KEY=
# Turnstile widget site key. 1x00000000000000000000AA = Cloudflare "always passes" test key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Cloudflare Images delivery base, e.g. https://imagedelivery.net/<account_hash>
VITE_CF_IMAGES_DELIVERY_URL=
# Canonical site URL (no trailing slash): sitemap, OG tags, email links.
VITE_SITE_URL=http://localhost:3000
# Demo mode: bundled sample data, no Firebase (client preview deploys only – a production build refuses it).
VITE_DEMO_MODE=false


# ---- functions (functions/) ------------------------------------------------
# Turnstile secret. 1x0000000000000000000000000000000AA = Cloudflare "always passes" test secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Stripe (test mode until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Resend. When RESEND_API_KEY is empty, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Solid Drive Auto WA <onboarding@resend.dev>"
DEALERSHIP_NOTIFY_EMAIL=sales@soliddrive.test
# Cloudflare Images (upload URLs, deletes)
CF_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
# Cloudflare cache purge for car pages
CF_ZONE_ID=
CF_CACHE_PURGE_TOKEN=
# Syndication feed key (M8)
STOCK_FEED_KEY=
# Public site URL used in emails and manage links (functions side)
SITE_URL=http://localhost:3000
